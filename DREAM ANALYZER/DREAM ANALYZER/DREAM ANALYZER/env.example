# Dream Analyzer Environment Configuration
# Copy this file to .env and update the values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/dream-analyzer
# For MongoDB Atlas, use: mongodb+srv://username:password@cluster.mongodb.net/dream-analyzer

# JWT Secret (change this in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OpenAI API Key (required for AI features)
OPENAI_API_KEY=your-openai-api-key-here

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Optional: Image Generation Fallback
# If OpenAI fails, you can use other services
# REPLICATE_API_TOKEN=your-replicate-token
# STABILITY_API_KEY=your-stability-key

# Optional: Email Service (for notifications)
# SENDGRID_API_KEY=your-sendgrid-key
# EMAIL_FROM=noreply@dreamanalyzer.com

# Optional: File Upload
# MAX_FILE_SIZE=10485760
# UPLOAD_PATH=./uploads
