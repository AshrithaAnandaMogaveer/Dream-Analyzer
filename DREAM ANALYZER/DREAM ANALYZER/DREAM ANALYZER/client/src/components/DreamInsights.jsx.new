import React, { useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { FaBrain, FaChevronDown, FaChevronUp } from 'react-icons/fa';
import './DreamInsights.css';

const DreamInsights = ({ dream }) => {
  const [expandedSections, setExpandedSections] = useState({
    yourDream: true,
    introduction: true,
    overview: true,
    keySymbols: true,
    psychological: true,
    cultural: true,
    connections: true,
    summary: true
  });

  // Section titles and icons
  const sectionTitles = {
    yourDream: '🌙 Your Dream',
    introduction: '🔍 Introduction',
    overview: '📜 Overview',
    keySymbols: '🔑 Key Symbols & Elements',
    psychological: '🧠 Psychological Interpretation',
    cultural: '🌍 Cultural Context',
    connections: '🔗 Connections to Waking Life',
    summary: '💡 Summary & Advice'
  };

  const sectionIcons = {
    yourDream: '🌙',
    introduction: '🔍',
    overview: '📜',
    keySymbols: '🔑',
    psychological: '🧠',
    cultural: '🌍',
    connections: '🔗',
    summary: '💡'
  };

  // Toggle section expansion
  const toggleSection = (section) => {
    setExpandedSections(prev => ({
      ...prev,
      [section]: !prev[section]
    }));
  };

  // Format date
  const formatDate = (dateString) => {
    if (!dateString) return '';
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', {
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });
  };

  if (!dream) return null;

  // Get the interpretation from dream.interpretation or use dream directly for backward compatibility
  const interpretation = dream.interpretation || dream;
  
  // Function to render section content with animations
  const renderSection = (sectionKey) => {
    const content = interpretation[sectionKey] || `No ${sectionKey.replace(/([A-Z])/g, ' $1').toLowerCase().trim()} available.`;
    
    return (
      <motion.div 
        key={sectionKey}
        className={`insight-section ${sectionKey}`}
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.3 }}
      >
        <div 
          className="section-header"
          onClick={() => toggleSection(sectionKey)}
        >
          <h3>
            {sectionIcons[sectionKey]}
            {sectionTitles[sectionKey]}
            {expandedSections[sectionKey] ? 
              <FaChevronUp className="toggle-icon" /> : 
              <FaChevronDown className="toggle-icon" />
            }
          </h3>
        </div>
        
        <AnimatePresence>
          {expandedSections[sectionKey] && (
            <motion.div
              className="section-content"
              initial={{ opacity: 0, height: 0 }}
              animate={{ opacity: 1, height: 'auto' }}
              exit={{ opacity: 0, height: 0 }}
              transition={{ duration: 0.3 }}
            >
              <div className="section-text">
                {typeof content === 'string' ? (
                  content.split('\n').map((paragraph, i) => (
                    <p key={i}>{paragraph || <br />}</p>
                  ))
                ) : (
                  <p>{JSON.stringify(content)}</p>
                )}
              </div>
            </motion.div>
          )}
        </AnimatePresence>
      </motion.div>
    );
  };

  return (
    <div className="dream-insights">
      <motion.div
        className="insights-header"
        initial={{ opacity: 0, y: -20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.5 }}
      >
        <h2>
          <FaBrain className="header-icon" />
          Dream Analysis
        </h2>
        <p className="dream-date">{formatDate(dream.createdAt)}</p>
      </motion.div>

      <div className="insights-content">
        {/* Render all sections in order */}
        {['yourDream', 'introduction', 'overview', 'keySymbols', 
          'psychological', 'cultural', 'connections', 'summary'].map(renderSection)}
        
        {/* Dream Image if available */}
        {dream.imageUrl && (
          <motion.div 
            className="dream-image-container"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            transition={{ delay: 0.5 }}
          >
            <img 
              src={dream.imageUrl} 
              alt="Dream visualization" 
              className="dream-image"
            />
          </motion.div>
        )}
      </div>
    </div>
  );
};

export default DreamInsights;
